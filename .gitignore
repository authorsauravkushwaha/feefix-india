# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime stores (local tracker + notification outbox)
# `runtime/` holds a live database, uploaded student documents, one-time-code
# peppers and local outboxes. Nothing in it belongs in git — including the
# document upload directory and the fuzzer's scratch databases, which live in
# subdirectories and were previously missed by these patterns.
runtime/*.json
runtime/*.jsonl
runtime/*.tmp
runtime/*.db
runtime/*.db-wal
runtime/*.db-shm
runtime/*
!runtime/.gitkeep

# Secrets — the OTP server-side pepper and any local env files must NEVER be
# committed (see docs/security/SECURITY.md). Keep secrets in the environment.
runtime/.otp_pepper
runtime/.*
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
.idea/
.vscode/

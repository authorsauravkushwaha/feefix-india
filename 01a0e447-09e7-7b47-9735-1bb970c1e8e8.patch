+.opt-card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
+.opt-card.sel { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 1px var(--accent); }
+.opt-card .ic { font-size: 1.35rem; line-height: 1; }
+.opt-card small { display: block; color: var(--text-soft); font-weight: 400; font-size: 0.8rem; }
+
+.pill-row { display: flex; gap: 10px; flex-wrap: wrap; }
+.pill {

+.wizard-card .help { color: var(--text-soft); font-size: 0.93rem; margin-bottom: 30px; }
+.wizard-actions { display: flex; justify-content: space-between; margin-top: 34px; gap: 12px; }
+
+/* option cards & pills */
+.opt-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
+.opt-card {
+  background: var(--bg-soft);

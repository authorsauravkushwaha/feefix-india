+.reach p { color: var(--text-soft); max-width: 520px; }
+.reach .mock { flex: 0 0 auto; }
+
+/* --- footer ----------------------------------------------------------------------------- */
+.footer {
+  border-top: 1px solid var(--border);
+  padding: 46px 0 40px;
+  margin-top: 40px;
+}
+.footer-inner { display: flex; gap: 34px; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; }
+.footer .f-brand { max-width: 380px; }
+.footer .f-brand p { color: var(--text-soft); font-size: 0.9rem; margin-top: 12px; }
+.footer small { color: var(--text-dim); display: block; margin-top: 26px; font-size: 0.8rem; }
+
+/* --- matcher wizard ------------------------------------------------------------------------ */
+.wizard { max-width: 740px; margin: 0 auto; }
+.progress-track {
+  height: 6px;
+  border-radius: 10px;
+  background: var(--surface-strong);

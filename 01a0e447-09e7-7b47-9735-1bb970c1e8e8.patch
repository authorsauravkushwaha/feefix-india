+.reminder-item.low .r-ic { background: var(--green-soft); }
+.reminder-item .r-tx { flex: 1; font-size: 0.93rem; color: var(--text-soft); }
+.reminder-item .r-tx b { color: var(--text); }
+.reminder-item .r-days {
+  flex: 0 0 auto;
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: 0.82rem;
+  color: var(--text-dim);
+  white-space: nowrap;
+}
+.board-group { margin-top: 40px; }
+.board-group h3 {
+  font-family: var(--font-display);
+  font-size: 1.1rem;
+  margin-bottom: 16px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.board-group h3 .count {
+  font-size: 0.72rem;
+  background: var(--surface-strong);
+  border-radius: 100px;
+  padding: 3px 10px;
+  color: var(--text-soft);
+}
+.status-stepper { display: flex; gap: 5px; margin-top: 14px; flex-wrap: wrap; }
+.dispatch-note {
+  font-size: 0.8rem;
+  color: var(--green);
+  margin-top: 12px;
+  animation: stepIn 0.4s;
+}
+
+/* --- explore ---------------------------------------------------------------------- */
+.filter-bar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 30px; align-items: center; }
+.filter-bar input[type="search"] {
+  flex: 1 1 280px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  color: var(--text);
+  font-family: inherit;
+  font-size: 0.95rem;
+  padding: 13px 18px;
+  outline: none;
+}
+.filter-bar input[type="search"]:focus { border-color: var(--accent); }
+.explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
+.explore-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 22px;
+  cursor: pointer;
+  transition: transform 0.22s, border-color 0.22s;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+.explore-card:hover { transform: translateY(-4px); border-color: var(--border-strong); }
+.explore-card h3 { font-family: var(--font-display); font-size: 1.02rem; letter-spacing: -0.01em; line-height: 1.35; }
+.explore-card .provider { color: var(--text-dim); font-size: 0.78rem; }
+.explore-card .bottom { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
+.explore-card .amt { font-family: var(--font-display); font-weight: 700; font-size: 0.88rem; color: var(--accent); }
+
+/* --- empty state --------------------------------------------------------------------- */
+.empty {
+  text-align: center;
+  padding: 70px 20px;
+  color: var(--text-soft);
+}
+.empty .big { font-size: 3rem; margin-bottom: 14px; }
+
+/* --- chat widget ------------------------------------------------------------------------- */
+.chat-fab {
+  position: fixed;
+  right: 26px;
+  bottom: 26px;
+  z-index: 70;
+  width: 62px;
+  height: 62px;
+  border-radius: 50%;
+  border: none;
+  cursor: pointer;
+  background: linear-gradient(135deg, var(--green), #059669);
+  color: white;
+  font-size: 1.5rem;
+  box-shadow: 0 14px 40px rgba(16, 185, 129, 0.4);
+  transition: transform 0.2s;
+  display: grid;
+  place-items: center;
+}
+.chat-fab:hover { transform: scale(1.08) rotate(4deg); }
+.chat-panel {
+  position: fixed;
+  right: 26px;
+  bottom: 100px;
+  width: min(392px, calc(100vw - 32px));
+  height: min(560px, calc(100vh - 150px));
+  background: var(--bg-soft);
+  border: 1px solid var(--border-strong);
+  border-radius: 22px;
+  z-index: 75;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  box-shadow: var(--shadow);
+  transform: translateY(22px) scale(0.96);
+  opacity: 0;
+  pointer-events: none;
+  transition: all 0.32s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.chat-panel.open { transform: none; opacity: 1; pointer-events: auto; }
+.chat-head {
+  padding: 16px 20px;
+  background: linear-gradient(135deg, rgba(16, 185, 129, 0.16), rgba(16, 185, 129, 0.05));
+  border-bottom: 1px solid var(--border);
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.chat-head .avatar {
+  width: 38px; height: 38px;
+  border-radius: 50%;
+  background: linear-gradient(135deg, var(--accent), var(--accent-2));
+  display: grid;
+  place-items: center;
+  font-weight: 800;
+  color: #1c1102;
+  font-family: var(--font-display);
+}
+.chat-head .t { font-weight: 700; font-size: 0.95rem; }
+.chat-head .s { font-size: 0.76rem; color: var(--green); }
+.chat-body {
+  flex: 1;
+  overflow-y: auto;
+  padding: 18px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.bub {
+  max-width: 82%;
+  padding: 11px 15px;
+  border-radius: 16px;
+  font-size: 0.9rem;
+  line-height: 1.5;
+  animation: bubIn 0.25s cubic-bezier(0.22, 1, 0.36, 1);
+  white-space: pre-wrap;
+}
+@keyframes bubIn { from { opacity: 0; transform: translateY(8px) scale(0.97); } }
+.bub.bot { background: var(--surface-strong); border-bottom-left-radius: 5px; align-self: flex-start; }
+.bub.user { background: linear-gradient(135deg, rgba(16, 185, 129, 0.75), rgba(5, 150, 105, 0.75)); border-bottom-right-radius: 5px; align-self: flex-end; }
+.typing { display: inline-flex; gap: 5px; padding: 14px 16px; }
+.typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--text-dim); animation: tp 1.1s infinite; }
+.typing i:nth-child(2) { animation-delay: 0.18s; }
+.typing i:nth-child(3) { animation-delay: 0.36s; }
+@keyframes tp { 0%,60%,100% { transform: none; opacity: 0.5; } 30% { transform: translateY(-5px); opacity: 1; } }
+.chat-input { display: flex; gap: 9px; padding: 12px 14px; border-top: 1px solid var(--border); }
+.chat-input input {
+  flex: 1;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 100px;
+  color: var(--text);
+  font-family: inherit;
+  font-size: 0.92rem;
+  padding: 11px 18px;
+  outline: none;
+}
+.chat-input input:focus { border-color: var(--green); }
+.chat-input button {
+  width: 44px; height: 44px;
+  border-radius: 50%;
+  border: none;
+  background: var(--green);
+  color: white;
+  cursor: pointer;
+  font-size: 1.05rem;
+  flex: 0 0 auto;
+}
+
+/* --- toast -------------------------------------------------------------------------------- */
+.toast {
+  position: fixed;
+  bottom: 28px;
+  left: 50%;
+  transform: translate(-50%, 20px);
+  background: var(--bg-soft);
+  border: 1px solid var(--border-strong);
+  color: var(--text);
+  border-radius: 100px;
+  padding: 12px 24px;
+  font-size: 0.9rem;
+  z-index: 100;
+  opacity: 0;
+  pointer-events: none;
+  transition: all 0.3s;
+  box-shadow: var(--shadow);
+}
+.toast.show { opacity: 1; transform: translate(-50%, 0); }
+
+/* --- view transitions & reveal ---------------------------------------------------------------- */
+#view > * { animation: viewIn 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
+@keyframes viewIn { from { opacity: 0; transform: translateY(14px); } }
+.reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s, transform 0.7s; }
+.reveal.in { opacity: 1; transform: none; }
+
+/* --- responsive --------------------------------------------------------------------------------- */
+@media (max-width: 940px) {
+  .stats, .results-summary { grid-template-columns: repeat(2, 1fr); }
+  .cards3, .explore-grid { grid-template-columns: 1fr; }
+  .dash-grid { grid-template-columns: repeat(2, 1fr); }
+  .match-card { grid-template-columns: auto 1fr; }
+  .match-side { grid-column: 1 / -1; flex-direction: row; align-items: center; }
+  .doc-list { columns: 1; }
+}
+@media (max-width: 620px) {
+  .nav-links a:not(.btn) { display: none; }
+  .stats, .results-summary, .dash-grid { grid-template-columns: 1fr; }
+  .wizard-card { padding: 30px 22px; }
+  .opt-grid { grid-template-columns: 1fr; }
+  .drawer { padding: 22px 20px 50px; }
+  .hero { padding: 60px 0 40px; }
+  .reach { padding: 34px 26px; }
+}
+
+/* --- Ask FeeFix (grounded AI Q&A) ------------------------------------------------ */
+.ask-box {
+  background:
+    radial-gradient(30rem 14rem at 0% 0%, rgba(139, 92, 246, 0.08), transparent 60%),
+    var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 22px 24px;
+  margin-bottom: 28px;
+}
+.ask-head {
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: 1.02rem;
+  margin-bottom: 14px;
+  background: linear-gradient(120deg, #c4b5fd, var(--violet));
+  -webkit-background-clip: text;
+  background-clip: text;
+  -webkit-text-fill-color: transparent;
+}
+.ask-row { display: flex; gap: 10px; }
+.ask-row input {
+  flex: 1;
+  background: var(--bg-soft);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  color: var(--text);
+  font-family: inherit;
+  font-size: 0.94rem;
+  padding: 12px 16px;
+  outline: none;
+}
+.ask-row input:focus { border-color: var(--violet); }
+.ask-out { margin-top: 16px; }
+.ask-loading { color: var(--text-dim); font-size: 0.9rem; animation: pulse 1.4s infinite; }
+.ask-answer {
+  background: var(--bg-soft);
+  border: 1px solid var(--border);
+  border-left: 3px solid var(--violet);
+  border-radius: 12px;
+  padding: 16px 18px;
+  font-size: 0.92rem;
+  line-height: 1.7;
+  color: var(--text-soft);
+}
+.ask-answer strong { color: var(--text); }
+.ask-answer em { color: var(--text-dim); font-size: 0.85rem; }
+.cite-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; align-items: center; }
+.cite-chip {
+  background: rgba(139, 92, 246, 0.1);
+  border: 1px solid rgba(139, 92, 246, 0.35);
+  color: #c4b5fd;
+  border-radius: 100px;
+  padding: 6px 13px;
+  font-family: inherit;
+  font-size: 0.78rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.18s;
+}
+.cite-chip:hover { background: rgba(139, 92, 246, 0.22); color: white; }
+.ask-mode { font-size: 0.74rem; color: var(--text-dim); margin-left: auto; }
+.chat-cites { padding: 0 16px 8px; }
+.advice {
+  width: 100%;
+  color: var(--text-dim);
+  font-size: 0.84rem;
+  font-style: italic;
+  margin-top: 2px;
+}
+@media (max-width: 620px) { .ask-row { flex-direction: column; } }
+
+/* --- ML preview ---------------------------------------------------------------------------- */
+.ml-chip {
+  color: #c4b5fd;
+  background: rgba(139, 92, 246, 0.14);
+  border-color: rgba(139, 92, 246, 0.4);
+}
+.ml-note {
+  color: var(--text-dim);
+  font-size: 0.78rem;
+  margin-bottom: 10px;
+  animation: stepIn 0.4s;
+}
+
+/* --- Auth modal & nav user ---------------------------------------------------------------- */
+.auth-modal {
+  position: fixed; inset: 0; display: none; align-items: center; justify-content: center;
+  background: rgba(5, 8, 18, 0.72); backdrop-filter: blur(4px); z-index: 90;
+}
+.auth-modal.open { display: flex; }
+.auth-card {
+  position: relative; width: min(420px, 92vw); background: var(--card, #101a30);
+  border: 1px solid var(--border, #233050); border-radius: 18px; padding: 28px;
+  animation: stepIn 0.25s;
+}
+.auth-card h3 { margin: 0 0 6px; }
+.auth-sub { color: var(--text-dim); font-size: 0.86rem; margin: 0 0 18px; }
+.auth-field { margin-bottom: 12px; }
+.auth-field label { display: block; font-size: 0.8rem; color: var(--text-dim); margin-bottom: 5px; }
+.auth-field input {
+  width: 100%; padding: 11px 13px; border-radius: 10px; font-size: 0.95rem;
+  background: var(--bg-input, #0b1426); border: 1px solid var(--border, #233050); color: inherit;
+}
+.auth-field input:focus { outline: none; border-color: var(--accent, #7c8cf8); }
+.auth-error { color: #f87171; font-size: 0.82rem; min-height: 1.1em; margin-bottom: 10px; }
+.auth-actions { display: flex; gap: 10px; }
+.auth-note { color: var(--text-dim); font-size: 0.72rem; margin: 16px 0 0; }
+.nav-user { font-size: 0.82rem; color: var(--text-dim); margin-right: 2px; }

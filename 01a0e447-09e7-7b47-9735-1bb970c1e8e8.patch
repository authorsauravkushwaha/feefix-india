+  box-shadow: 0 4px 16px rgba(249, 115, 22, 0.5);
+}
+.range-marks { display: flex; justify-content: space-between; color: var(--text-dim); font-size: 0.78rem; margin-top: 10px; }
+
+/* marks + checks */
+.marks-input { display: flex; align-items: center; justify-content: center; gap: 12px; }
+.marks-input input {
+  width: 150px;
+  background: var(--bg-soft);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  color: var(--text);
+  font-family: var(--font-display);
+  font-size: 2rem;
+  font-weight: 700;
+  text-align: center;
+  padding: 12px;
+  outline: none;
+}
+.marks-input input:focus { border-color: var(--accent); }
+.marks-input span { color: var(--text-soft); font-size: 1.4rem; }
+.check-row { display: flex; flex-direction: column; gap: 12px; }
+.check {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  background: var(--bg-soft);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 16px 18px;
+  cursor: pointer;
+  transition: all 0.2s;
+  font-size: 0.95rem;
+}
+.check input { display: none; }
+.check .box {
+  width: 22px; height: 22px;
+  border-radius: 7px;
+  border: 2px solid var(--border-strong);
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  transition: all 0.18s;
+  color: transparent;
+  font-size: 0.75rem;
+}
+.check.sel { border-color: var(--accent); background: var(--accent-soft); }
+.check.sel .box { background: linear-gradient(135deg, var(--accent), var(--accent-2)); border-color: transparent; color: #1c1102; }
+.community-row { margin-top: 14px; display: none; }
+.community-row.show { display: block; animation: stepIn 0.3s; }
+.community-row select {
+  width: 100%;
+  background: var(--bg-soft);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  color: var(--text);
+  font-family: inherit;
+  padding: 13px 16px;
+  font-size: 0.95rem;
+  outline: none;
+}
+
+/* --- results ---------------------------------------------------------------------------- */
+.results-summary {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 16px;
+  margin-bottom: 40px;
+}
+.match-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 26px;
+  display: grid;
+  grid-template-columns: auto 1fr auto;

+.badge.high_value { color: var(--amber); background: var(--amber-soft); border-color: rgba(251, 191, 36, 0.3); }
+.badge.fee_waiver { color: var(--violet); background: rgba(139, 92, 246, 0.13); border-color: rgba(139, 92, 246, 0.3); }
+.badge.state_scheme, .badge.all_india { color: var(--text-soft); }
+.badge.verified { color: var(--green); background: var(--green-soft); border-color: rgba(16, 185, 129, 0.3); }
+.badge.window_closed { color: var(--text-dim); }
+
+.why-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 4px; }
+.why-item { display: flex; gap: 10px; align-items: flex-start; font-size: 0.9rem; color: var(--text-soft); }
+.why-item .tick { color: var(--green); font-weight: 800; flex: 0 0 auto; }
+.why-item.warn .tick { color: var(--amber); }
+
+.match-side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 14px; min-width: 150px; }
+.deadline-chip {
+  font-size: 0.8rem;
+  font-weight: 700;
+  padding: 6px 13px;
+  border-radius: 100px;
+  text-align: center;
+}
+.deadline-chip.green { color: var(--green); background: var(--green-soft); }
+.deadline-chip.amber { color: var(--amber); background: var(--amber-soft); }
+.deadline-chip.red { color: var(--red); background: var(--red-soft); }
+.deadline-chip.grey { color: var(--text-dim); background: var(--surface-strong); }
+.benefit-amount { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--text); text-align: right; }
+
+.match-actions { display: flex; gap: 10px; }
+
+.near-block { margin-top: 54px; }
+.near-card {
+  background: var(--surface);
+  border: 1px dashed var(--border-strong);
+  border-radius: var(--radius);

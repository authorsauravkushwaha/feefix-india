+  margin-bottom: 16px;
+  transition: border-color 0.25s, transform 0.25s;
+  animation: cardIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
+}
+@keyframes cardIn { from { opacity: 0; transform: translateY(18px); } }
+.match-card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
+.score-ring { position: relative; width: 84px; height: 84px; flex: 0 0 auto; }
+.score-ring svg { transform: rotate(-90deg); }
+.score-ring .val {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: 1.25rem;
+}
+.match-body h3 { font-family: var(--font-display); font-size: 1.18rem; letter-spacing: -0.01em; margin-bottom: 4px; }
+.match-body .provider { color: var(--text-dim); font-size: 0.84rem; margin-bottom: 12px; }
+.badge-row { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 14px; }
+.badge {
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  padding: 4px 11px;
+  border-radius: 100px;
+  border: 1px solid var(--border-strong);
+  color: var(--text-soft);
+  text-transform: uppercase;
+}
+.badge.top_pick { color: #1c1102; background: linear-gradient(135deg, var(--accent), var(--accent-2)); border: none; }

+.btn-small { padding: 9px 16px; font-size: 0.86rem; border-radius: 11px; }
+.btn[disabled] { opacity: 0.45; cursor: not-allowed; transform: none !important; }
+
+/* --- hero --------------------------------------------------------------------- */
+.hero { padding: 92px 0 58px; text-align: center; position: relative; }
+.hero-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  font-size: 0.82rem;
+  font-weight: 600;
+  letter-spacing: 0.14em;

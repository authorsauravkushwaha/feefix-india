+.drawer .provider { color: var(--text-dim); font-size: 0.86rem; margin-bottom: 20px; }
+.d-section { margin-top: 28px; }
+.d-section h4 {
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--accent);

+.near-card .blocker { color: var(--amber); font-size: 0.86rem; display: flex; gap: 8px; align-items: flex-start; max-width: 480px; }
+
+/* --- scheme drawer ------------------------------------------------------------------ */
+.drawer-scrim {
+  position: fixed;
+  inset: 0;
+  background: rgba(3, 5, 10, 0.7);
+  backdrop-filter: blur(6px);
+  z-index: 80;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity 0.3s;
+}
+.drawer-scrim.open { opacity: 1; pointer-events: auto; }
+.drawer {
+  position: fixed;
+  top: 0;
+  right: 0;
+  bottom: 0;
+  width: min(680px, 100vw);
+  background: var(--bg-soft);
+  border-left: 1px solid var(--border-strong);
+  z-index: 90;
+  transform: translateX(102%);

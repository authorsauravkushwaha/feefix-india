+}
+.how-card h3 { font-family: var(--font-display); font-size: 1.22rem; margin-bottom: 10px; letter-spacing: -0.01em; }
+.how-card p { color: var(--text-soft); font-size: 0.94rem; }
+.how-card::after {
+  content: "";

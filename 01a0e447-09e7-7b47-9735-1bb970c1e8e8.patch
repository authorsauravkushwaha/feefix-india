+}
+.step-meta { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
+.step-count { font-size: 0.82rem; color: var(--text-dim); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
+.wizard-card {
+  background: var(--surface);
+  border: 1px solid var(--border);

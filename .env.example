# FeeFix India — example environment file.
#
# Copy to `.env` and fill in what you need (`.env` and `.env.*` are git-ignored;
# this example is committed and must never contain a real credential).
# Everything here is optional: the app runs with none of it set.

# --- runtime / storage ------------------------------------------------------
FEEFIX_DB=runtime/feefix.db              # SQLite file (WAL) — accounts, sessions, counters
FEEFIX_UPLOAD_DIR=runtime/uploads        # uploaded documents, NEVER under the web root
FEEFIX_STORE=sqlite                      # sqlite (default) | json (legacy)

# --- deployment posture -----------------------------------------------------
# Production markers (RENDER / FLY_APP_NAME / K_SERVICE) enable strict mode
# automatically; set this explicitly if you deploy somewhere else.
FEEFIX_STRICT_SECRETS=1                  # refuse to boot on placeholder secrets
FEEFIX_TRUSTED_PROXY_COUNT=1             # how many proxies sit in front of the app
FEEFIX_DISABLE_DOCS=0                    # 1 = hide /docs (cosmetic, not a control)

# --- rate limiting ----------------------------------------------------------
# Default store is the shared SQLite one: correct for any number of worker
# processes on ONE host. Multiple instances need Redis, or limits multiply.
# FEEFIX_REDIS_URL=redis://localhost:6379/0
FEEFIX_RATE_LIMIT_BACKEND=auto           # auto | sqlite | redis | memory
FEEFIX_RATELIMIT_FAIL_MODE=open          # closed = refuse traffic when the store is down

# --- password hashing -------------------------------------------------------
FEEFIX_ARGON2_TIME_COST=3                # Argon2id t
FEEFIX_ARGON2_MEMORY_KIB=49152           # Argon2id m (48 MiB)
FEEFIX_ARGON2_PARALLELISM=1              # Argon2id p
FEEFIX_KDF_CONCURRENCY=4                 # concurrent KDF bound (RAM-exhaustion guard)

# --- sessions ---------------------------------------------------------------
FEEFIX_SESSION_REUSE_POLICY=quarantine   # quarantine | revoke_family | observe
FEEFIX_SESSION_REUSE_ESCALATE=3          # replays before the family is revoked

# --- limits -----------------------------------------------------------------
FEEFIX_MAX_BODY_BYTES=262144             # default per-request body cap
FEEFIX_MAX_UPLOAD_BYTES=8000000          # per-document cap
FEEFIX_MAX_MESSAGE_LEN=2000              # chat turn
FEEFIX_MAX_QUESTION_LEN=1000             # grounded Q&A question

# --- AI (free, local, no keys ever) -----------------------------------------
FEEFIX_AI_BACKEND=auto                   # auto | neural | ngram (ngram = no download)
FEEFIX_AI_ALLOW_DOWNLOAD=1               # 0 = never try to fetch model weights
FEEFIX_AI_LOAD_TIMEOUT=20                # seconds before falling back to ngram

# --- secrets (never commit real values) -------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FEEFIX_OTP_PEPPER=
# OTP_SMTP_HOST=
# OTP_SMTP_USER=
# OTP_SMTP_PASS=
# OTP_TWILIO_SID=
# OTP_TWILIO_TOKEN=
# FEEFIX_REQUIRED_SECRETS=              # comma-separated names that MUST be set

# ============================================================================
# Full configuration reference (every optional knob, commented out).
# ============================================================================
# FeeFix India — configuration reference.
#
# Copy what you need into your deployment; locally, `cp .env.example .env` and
# uncomment what you need — scripts/dev.sh loads ./.env (gitignored). Nothing
# here is required for the app to run in development. The boot guards only *enforce*
# these in production — see docs/deploy/DEPLOYMENT.md and
# docs/security/HARDENING.md.
#
# Naming: our own knobs are FEEFIX_*; credentials for external providers keep
# the provider's conventional name (OTP_SMTP_PASS, GITHUB_CLIENT_SECRET, …)
# because third-party tooling and dashboards refer to them that way. The
# secret-hygiene checker knows both and validates whichever you set.

# ---- environment ----------------------------------------------------------- #
# FEEFIX_ENV=production              # turns on fail-closed boot guards
# FEEFIX_PASSWORD_ALGO=argon2id      # production default; PBKDF2 is legacy/dev only
# FEEFIX_SECRETS_STRICT=1            # refuse to boot on placeholder secrets (always on when FEEFIX_ENV=production)
# FEEFIX_SECRETS_STRICT=0            # ignored in production — a placeholder secret will not boot

# ---- state (put both on a mounted volume in production) -------------------- #
# FEEFIX_DB=/data/feefix.db
# FEEFIX_UPLOAD_DIR=/data/uploads

# ---- shared state across workers/instances --------------------------------- #
# Without this, each worker keeps its own counters: the effective rate limit
# becomes N× the configured one and an attacker just spreads requests.
# FEEFIX_REDIS_URL=rediss://default:<your-password>@host:6379
# FEEFIX_RATELIMIT_BACKEND=auto      # auto | memory | sqlite | redis
# FEEFIX_RATELIMIT_DB=               # shared-file limiter (default: beside FEEFIX_DB). Host-wide, not multi-instance.
# FEEFIX_INSTANCES=1                 # set to the real instance count; >1 without Redis refuses to boot
# FEEFIX_RATELIMIT_FAIL_MODE=auth    # which buckets fail closed when the store is down
# FEEFIX_TRUST_PROXY=1               # set when TLS terminates in front of the app

# ---- OTP delivery — sign-in codes go to the student's inbox/phone ---- #
# Set ONE email gateway and/or ONE SMS gateway. The first configured one wins
# (or pin it with OTP_EMAIL_PROVIDER / OTP_SMS_PROVIDER). Unset = no gateway:
# outside production the code is shown as a labelled demo, in production the
# endpoint answers 503 and the UI hides that door — codes are never faked.
# Verify any of it with:  python scripts/check_otp_delivery.py --email you@gmail.com
# Full walkthrough: docs/deploy/DEPLOYMENT.md
#
# FEEFIX_OTP_PEPPER=                 # 16+ random chars; REQUIRED once a channel below is set
# FEEFIX_OTP_DEV_ECHO=0              # refuse the demo code even outside production
# FEEFIX_OTP_DEV_ECHO_PHONE=0        # per-channel variant (…_EMAIL exists too)
# FEEFIX_OTP_TTL_S=300               # code lifetime (60-900 s)
# FEEFIX_OTP_RESEND_S=40             # resend cooldown (15-300 s)
# FEEFIX_OTP_PER_HOUR=5              # codes per destination per hour (1-20)
# FEEFIX_OTP_DAILY_CAP=10            # codes per destination per day (3-50, anti-fraud)
# FEEFIX_OTP_ATTEMPTS=5              # wrong-code attempts before the code burns (3-10)
# OTP_DEFAULT_COUNTRY_CODE=+91       # country code for a bare 10-digit mobile
# OTP_EMAIL_PROVIDER=smtp            # smtp | brevo | resend | webhook
# OTP_SMS_PROVIDER=twilio            # twilio | msg91 | fast2sms | vonage | webhook
# OTP_EMAIL_SUBJECT="Your FeeFix verification code"
# OTP_SMS_TEMPLATE="{code} is your FeeFix verification code. Valid for {minutes} minutes."

# --- email: SMTP works with Gmail (app password), Yahoo, Outlook, SES, Postmark…
# OTP_SMTP_HOST=smtp.gmail.com
# OTP_SMTP_PORT=587                  # 465 = implicit TLS (OTP_SMTP_SECURE=1)
# OTP_SMTP_STARTTLS=required         # required | auto (local relays) | off
# OTP_SMTP_USER=you@gmail.com
# OTP_SMTP_PASS=                     # Gmail: a 16-character *app password*
# OTP_SMTP_FROM=you@gmail.com
# OTP_SMTP_FROM_NAME=FeeFix

# --- email: HTTPS APIs (free tiers, useful when the host blocks SMTP ports)
# OTP_BREVO_API_KEY=
# OTP_BREVO_FROM=you@example.com
# OTP_RESEND_API_KEY=
# OTP_RESEND_FROM="FeeFix <onboarding@resend.dev>"
# OTP_EMAIL_WEBHOOK_URL=https://your-endpoint/send-otp
# OTP_EMAIL_WEBHOOK_TOKEN=

# --- SMS: Twilio (global, paid)
# OTP_TWILIO_SID=
# OTP_TWILIO_TOKEN=
# OTP_TWILIO_FROM=+15005550006
# OTP_TWILIO_MESSAGING_SERVICE_SID=  # alternative to OTP_TWILIO_FROM

# --- SMS: India (DLT templates required by law for transactional SMS)
# OTP_MSG91_AUTH_KEY=
# OTP_MSG91_TEMPLATE_ID=
# OTP_MSG91_MODE=flow                # flow (DLT template) | otp (Send-OTP endpoint)
# OTP_MSG91_VAR=VAR1                 # template variable that carries the code
# OTP_MSG91_SENDER_ID=
# OTP_FAST2SMS_KEY=
# OTP_FAST2SMS_ROUTE=q               # q (quick) | dlt (needs sender id + template id)
# OTP_FAST2SMS_SENDER_ID=
# OTP_FAST2SMS_TEMPLATE_ID=
#
# --- SMS: Vonage (Nexmo) or your own gateway
# OTP_VONAGE_API_KEY=
# OTP_VONAGE_API_SECRET=
# OTP_VONAGE_FROM=FeeFix
# OTP_SMS_WEBHOOK_URL=https://your-endpoint/send-sms
# OTP_SMS_WEBHOOK_TOKEN=

# ---- GitHub sign-in (optional) --------------------------------------------- #
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=              # paired with GITHUB_CLIENT_ID

# ---- tuning (optional; every value is clamped to a safe range) -------------- #
# FEEFIX_MAX_BODY_BYTES=1000000      # catch-all API body cap
# FEEFIX_MAX_BODY_CONVERSATION_BYTES=64000
# FEEFIX_MAX_BODY_NOTES_BYTES=28000
# FEEFIX_MAX_BODY_UPLOAD_BYTES=2064000
# FEEFIX_MAX_UPLOAD_BYTES=2000000
# FEEFIX_MAX_MESSAGE_LEN=2000
# FEEFIX_MAX_NOTES_LEN=20000
# FEEFIX_MAX_UPLOAD_FILES=20
# FEEFIX_MAX_UPLOAD_TOTAL_BYTES=20000000
# FEEFIX_REPLAY_POLICY=balanced      # balanced | lenient | strict
# FEEFIX_TOKEN_OVERLAP_S=900
# FEEFIX_CORS_ORIGINS=               # keep empty unless web and API are split
# FEEFIX_DISABLE_DOCS=1              # cosmetic: hides /docs and /redoc only. /openapi.json stays.
# FEEFIX_AI_BACKEND=ngram            # ngram (built-in, offline) | fastembed
